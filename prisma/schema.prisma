// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PIC
  VIEWER
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- MASTER DATA WILAYAH ---
model Region {
  id       String        @id @default(uuid())
  name     String
  kode     String     @unique
  users User[]
  branches Branch[]
  activityReports ActivityReport[]
}

model Branch {
  id String @id @default(uuid())
  name String

  regionId String
  region Region @relation(fields: [regionId], references: [id])

  activityReports ActivityReport[]

  users User[]
}

model Division {
  id String @id @default(uuid())
  name String

  activityReports ActivityReport[]

  users User[]
}

model User {
  id String @id @default(uuid())
  username String? @unique
  password String?
  
  authProvider String @default("LOCAL")
  samlNameId String? @unique

  name String
  
  role Role @default(VIEWER)

  regionId String?
  region Region? @relation(fields: [regionId], references: [id])

  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id])

  divisionId String?
  division Division? @relation(fields: [divisionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramBudaya {
  id String @id @default(uuid())

  name String

  description String

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityReports ActivityReport[]
}

model ActivityReport {
  id String @id @default(uuid())

  regionId String?
  region Region? @relation(fields: [regionId], references: [id])

  branchId String?
  branch Branch? @relation(fields: [branchId], references: [id])

  divisionId String?
  division Division? @relation(fields: [divisionId], references: [id])

  programId String?
  program ProgramBudaya? @relation(fields: [programId], references: [id])

  activityName String
  
  tanggalKegiatan DateTime

  lokasi String
  description String

  picKegiatan String

  status ReportStatus @default(PENDING)



  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes String?

  photos ActivityPhoto[]

  @@index([regionId])
  @@index([branchId])
  @@index([divisionId])
}

model ActivityPhoto {
  id Int @id @default(autoincrement())

  reportId String
  report ActivityReport @relation(fields: [reportId], references: [id])

  originalName String

  imageUrl String
}

