// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PIC
  VIEWER
}

enum ProgramUnit {
  KEGIATAN
  PARTISIPASI_PERSEN
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActivityAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
}

// --- MASTER DATA WILAYAH ---
// NEW ENUM : UNIT TYPE
enum UnitType {
  DIVISI
  KANTOR_WILAYAH
  KANTOR_CABANG
}

// NEW MODEL UNIT
model Unit {
  id String @id @default(uuid())
  name String
  type UnitType

  kodeDolog String
  kodeSubdolog String
  kodeOrg String
  kodeDivisi String?

  parentId     String?
  parent       Unit?    @relation("UnitHierarchy", fields: [parentId], references: [id])
  children     Unit[]   @relation("UnitHierarchy")

  users User[]
  activityReport ActivityReport[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([kodeDolog, kodeSubdolog])
  @@index([parentId])
}

model User {
  id String @id @default(uuid())
  username String? @unique
  password String?
  
  authProvider String @default("LOCAL")
  samlNameId String? @unique

  name String
  
  role Role @default(VIEWER)
  isActive Boolean @default(true)

  unitId String?
  unit Unit? @relation(fields: [unitId], references: [id])

  passwordChangedAt DateTime? @default(now())

  createdReports ActivityReport[] @relation("CreatedReports")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramCategory {
  id String @id @default(uuid())
  name String @unique
  color String?

  bannerUrl String?
  targetUnit ProgramUnit @default(KEGIATAN)
  defaultFrequency Int @default(1)

  
  programs ProgramBudaya[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramBudaya {
  id String @id @default(uuid())

  name String

  bannerUrl String?

  frequency Int @default(1)
  tw Int?
  startDate DateTime
  endDate DateTime
  isActive Boolean @default(true)

  categoryId String?
  category ProgramCategory? @relation(fields: [categoryId], references: [id])
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityReports ActivityReport[]
}

model ActivityReport {
  id String @id @default(uuid())

  unitId String?
  unit Unit? @relation(fields: [unitId], references: [id])

  createdById String?
  createdBy User? @relation("CreatedReports", fields: [createdById], references: [id])

  programId String?
  program ProgramBudaya? @relation(fields: [programId], references: [id])

  activityName String
  
  tanggalKegiatan DateTime

  lokasi String
  description String

  status ReportStatus @default(PENDING)



  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes String?

  photos ActivityPhoto[]

  logs ActivityLog[]

  @@index([unitId])
  @@index([createdById])
}

model ActivityLog {
  id String @id @default(uuid())
  reportId String
  report ActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  action ActivityAction
  notes String?

  actorId String?
  actorName String?
  actorRole String?

  createdAt DateTime @default(now())

  @@index([reportId])
}
model ActivityPhoto {
  id Int @id @default(autoincrement())

  reportId String
  report ActivityReport @relation(fields: [reportId], references: [id])

  originalName String

  imageUrl  String
  publicId  String? // Cloudinary public_id untuk keperluan delete
}

model LoginBanner {
  id String @id @default(uuid())
  imageUrl String
  name String
  role String
  unit String
  period String
  order Int @default(0)
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}



