// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with PostgreSQL?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PIC
  VIEWER
}

enum EvidenceMode {
  NONE
  PHOTO_WITH_AI
  PHOTO_WITHOUT_AI
}

enum ScoreInputMode {
  NONE
  EXCEL_IMPORT
  DIRECT_ADMIN
}

enum ScoreHistoryAction {
  CREATED
  UPDATED
}

enum ProgramUnit {
  KEGIATAN
  PARTISIPASI_PERSEN
}

enum ReportStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActivityAction {
  SUBMITTED
  APPROVED
  REJECTED
  RESUBMITTED
}

// --- MASTER DATA WILAYAH ---
// NEW ENUM : UNIT TYPE
enum UnitType {
  DIVISI
  KANTOR_WILAYAH
  KANTOR_CABANG
}

enum EmployeeSyncRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ParticipationProvenance {
  LEGACY
  EMPLOYEE_SNAPSHOT
}

// NEW MODEL UNIT
model Unit {
  id   String   @id @default(uuid())
  name String
  type UnitType

  kodeDolog    String
  kodeSubdolog String
  kodeOrg      String
  kodeDivisi   String?

  parentId String?
  parent   Unit?   @relation("UnitHierarchy", fields: [parentId], references: [id])
  children Unit[]  @relation("UnitHierarchy")

  users             User[]
  employees         Employee[]
  activityReport    ActivityReport[]
  participationData ParticipationData[]
  externalMappings  UnitExternalMapping[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([kodeDolog, kodeSubdolog])
  @@index([parentId])
}

model User {
  id       String  @id @default(uuid())
  username String? @unique
  password String?

  authProvider String  @default("LOCAL")
  samlNameId   String? @unique

  name String

  role     Role    @default(VIEWER)
  isActive Boolean @default(true)

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  employeeId String? @unique
  employee   Employee? @relation("EmployeeUser", fields: [employeeId], references: [id], onDelete: SetNull)

  passwordChangedAt DateTime? @default(now())

  createdReports         ActivityReport[]    @relation("CreatedReports")
  importedParticipations ParticipationData[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessedParticipations ParticipationData[] @relation("ParticipationAssessors")
  scoreHistoryEntries    ParticipationScoreHistory[] @relation("ScoreHistoryActors")
  correctionAudits       ParticipationCorrectionAudit[] @relation("ParticipationCorrectionActors")

  @@index([role])
  @@index([isActive])
  @@index([authProvider])
  @@index([unitId])
}

model ProgramCategory {
  id    String  @id @default(uuid())
  name  String  @unique
  color String?

  bannerUrl        String?
  targetUnit       ProgramUnit @default(KEGIATAN)
  defaultFrequency Int         @default(1)

  evidenceMode EvidenceMode @default(PHOTO_WITH_AI)
  scoreInputMode ScoreInputMode @default(NONE)
  scoreHistories ParticipationScoreHistory[]

  programs          ProgramBudaya[]
  participationData ParticipationData[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramBudaya {
  id String @id @default(uuid())

  name String

  bannerUrl String?

  frequency      Int      @default(1)
  tw             Int?
  startDate      DateTime
  endDate        DateTime
  uploadDeadline DateTime
  isActive       Boolean  @default(true)

  categoryId  String?
  category    ProgramCategory? @relation(fields: [categoryId], references: [id])
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activityReports ActivityReport[]

  @@index([isActive])
  @@index([categoryId])
  @@index([tw])
  @@index([startDate, endDate, uploadDeadline])
}

model ParticipationData {
  id           String          @id @default(uuid())
  unitId       String
  unit         Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  categoryId   String
  category     ProgramCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tw           Int
  year         Int
  percentage   Decimal? @db.Decimal(5, 2)
  headcount Int?
  participantCount Int?
  provenance ParticipationProvenance @default(LEGACY)
  employeeSyncRunId String?
  headcountCapturedAt DateTime?
  unitNameSnapshot String?
  parentUnitNameSnapshot String?
  categoryNameSnapshot String?
  evidenceReportId String? @unique
  evidenceReport    ActivityReport? @relation("ParticipationEvidence", fields: [evidenceReportId], references: [id], onDelete: Restrict)
  assessedById     String?
  assessedBy       User? @relation("ParticipationAssessors", fields: [assessedById], references: [id], onDelete: Restrict)
  assessedAt       DateTime?
  updatedAt        DateTime @updatedAt
  scoreHistories   ParticipationScoreHistory[]
  importedAt   DateTime        @default(now())
  importedById String?
  importedBy   User?           @relation(fields: [importedById], references: [id], onDelete: SetNull)
  employeeSyncRun EmployeeSyncRun? @relation("ParticipationEmployeeSyncRun", fields: [employeeSyncRunId], references: [id], onDelete: Restrict)
  correctionAudits ParticipationCorrectionAudit[]

  @@unique([unitId, categoryId, tw, year])
  @@index([categoryId])
  @@index([year, tw])
  @@index([unitId])
  @@index([employeeSyncRunId])
}

model ParticipationScoreHistory {
  id                  String             @id @default(uuid())
  participationDataId String
  participationData   ParticipationData @relation(fields: [participationDataId], references: [id], onDelete: Restrict)
  evidenceReportId    String
  evidenceReport      ActivityReport    @relation(fields: [evidenceReportId], references: [id], onDelete: Restrict)
  categoryId          String
  category            ProgramCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  action              ScoreHistoryAction
  previousPercentage  Decimal? @db.Decimal(5, 2)
  newPercentage       Decimal @db.Decimal(5, 2)
  changeReason        String?
  actorId             String?
  actor               User?              @relation("ScoreHistoryActors", fields: [actorId], references: [id], onDelete: SetNull)
  actorName           String
  createdAt           DateTime           @default(now())

  @@index([participationDataId, createdAt])
  @@index([evidenceReportId])
  @@index([categoryId])
}

model EmployeeSyncRun {
  id String @id @default(uuid())
  sourceSystem String
  sourceMetadata Json?
  status EmployeeSyncRunStatus @default(RUNNING)
  startedAt DateTime @default(now())
  completedAt DateTime?
  receivedCount Int @default(0)
  processedCount Int @default(0)
  missingCount Int @default(0)
  errorMessage String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employeesLastSeen Employee[] @relation("EmployeeLastSeenSyncRun")
  participationSnapshots ParticipationData[] @relation("ParticipationEmployeeSyncRun")

  @@index([status])
  @@index([startedAt])
  @@index([status, completedAt])
}

model Employee {
  id String @id @default(uuid())
  nip String @unique
  name String
  jenjang String
  kodeStatpeg String
  statKepeg String
  unitId String?
  unit Unit? @relation(fields: [unitId], references: [id], onDelete: SetNull)
  isPresentInSource Boolean @default(false)
  lastSeenAt DateTime?
  lastSeenSyncRunId String?
  lastSeenSyncRun EmployeeSyncRun? @relation("EmployeeLastSeenSyncRun", fields: [lastSeenSyncRunId], references: [id], onDelete: SetNull)
  user User? @relation("EmployeeUser")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([unitId])
  @@index([isPresentInSource])
  @@index([jenjang, kodeStatpeg, statKepeg, isPresentInSource])
}

model UnitExternalMapping {
  id String @id @default(uuid())
  sourceSystem String
  externalUnitCode String
  unitId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceSystem, externalUnitCode])
  @@index([unitId])
}

model ParticipationCorrectionAudit {
  id String @id @default(uuid())
  participationDataId String
  participationData ParticipationData @relation(fields: [participationDataId], references: [id], onDelete: Restrict)
  previousParticipantCount Int?
  newParticipantCount Int
  previousPercentage Decimal? @db.Decimal(5, 2)
  newPercentage Decimal @db.Decimal(5, 2)
  reason String
  actorId String?
  actor User? @relation("ParticipationCorrectionActors", fields: [actorId], references: [id], onDelete: SetNull)
  actorName String
  createdAt DateTime @default(now())

  @@index([participationDataId, createdAt])
  @@index([actorId])
}

model ActivityReport {
  id String @id @default(uuid())

  unitId String?
  unit   Unit?   @relation(fields: [unitId], references: [id])

  createdById String?
  createdBy   User?   @relation("CreatedReports", fields: [createdById], references: [id])

  programId String?
  program   ProgramBudaya? @relation(fields: [programId], references: [id])

  activityName String

  tanggalKegiatan DateTime

  lokasi      String
  description String

  status ReportStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes String?

  photos ActivityPhoto[]

  logs ActivityLog[]

  participationAssessment ParticipationData? @relation("ParticipationEvidence")
  scoreHistories          ParticipationScoreHistory[]

  @@index([unitId])
  @@index([createdById])
  @@index([status])
  @@index([programId])
  @@index([tanggalKegiatan])
  @@index([status, unitId])
  @@index([unitId, programId, tanggalKegiatan])
}

model ActivityLog {
  id       String         @id @default(uuid())
  reportId String
  report   ActivityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  action ActivityAction
  notes  String?

  actorId   String?
  actorName String?
  actorRole String?

  createdAt DateTime @default(now())

  @@index([reportId])
}

model ActivityPhoto {
  id Int @id @default(autoincrement())

  reportId String
  report   ActivityReport @relation(fields: [reportId], references: [id])

  originalName String

  imageUrl String
  publicId String? // Cloudinary public_id untuk keperluan delete

  @@index([reportId])
}

model LoginBanner {
  id        String   @id @default(uuid())
  imageUrl  String
  name      String
  role      String
  unit      String
  period    String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PicImportantInformation {
  id         String   @id @default(uuid())
  imageUrl   String
  altText    String
  width      Int
  height     Int
  order      Int      @default(0)
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([order, createdAt, id])
  @@index([isActive, order, createdAt, id])
}

model PicImportantInformationOrderState {
  id String @id
  revision Int @default(0)
  updatedAt DateTime @updatedAt
}